---
import '@fontsource-variable/onest';
import '../styles/global.css';
import { t, LANGS, type Lang } from '../i18n/t';

interface Props { lang: Lang; page: 'calc' | 'how'; title?: string }
const { lang, page, title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hrefFor = (l: Lang) => `${base}/${l}/${page === 'how' ? 'how-we-calculate/' : ''}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ?? t(lang, 'meta.title')}</title>
    <meta name="description" content={t(lang, 'meta.description')} />
    <meta name="theme-color" content="#f6f5f4" />
    <meta name="color-scheme" content="light" />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={hrefFor(l)} />)}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div class="washes" aria-hidden="true"><i></i></div>
    <div class="shell">
      <header class="topbar">
        <a class="brand" href={`${base}/${lang}/`}>
          <span><b>{t(lang, 'brand.name')}</b><small>{t(lang, 'brand.sub')}</small></span>
        </a>
        <nav class="topnav" aria-label="Main">
          <a href={`${base}/${lang}/`} aria-current={page === 'calc' ? 'page' : undefined}>{t(lang, 'nav.calc')}</a>
          <a href={`${base}/${lang}/how-we-calculate/`} aria-current={page === 'how' ? 'page' : undefined}>{t(lang, 'nav.how')}</a>
        </nav>
        <nav class="langs langswitch" aria-label={t(lang, 'lang.label')}>
          {LANGS.map((l) => (
            <a href={hrefFor(l)} data-keep-hash hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{l.toUpperCase()}</a>
          ))}
        </nav>
      </header>
      <slot />
      <footer class="foot">
        <p>{t(lang, 'privacy')}</p>
        <p>{t(lang, 'disclaimer')}</p>
      </footer>
    </div>
    <script>
      // Carry the calculation (URL fragment) across the language switch.
      document.querySelectorAll<HTMLAnchorElement>('a[data-keep-hash]').forEach((a) =>
        a.addEventListener('click', () => {
          if (location.hash) a.href = a.href.split('#')[0] + location.hash;
        }),
      );
    </script>
  </body>
</html>
