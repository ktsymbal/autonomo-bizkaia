---
import Base from '../../layouts/Base.astro';
import { LANGS, t, tList, date, type Lang } from '../../i18n/t';
import { rawParams, type Key } from '../../params';
import { paramText } from '../../i18n/paramText';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const raw = rawParams(2026);
const keys = Object.keys(raw) as Key[];
const open = keys.filter((k) => raw[k].status === '?');
const nf = new Intl.NumberFormat(lang === 'uk' ? 'uk-UA' : 'en-GB', { maximumFractionDigits: 2 });
const show = (v: unknown): string => {
  if (typeof v === 'number') return v > 0 && v < 1 ? `${nf.format(v * 100)} %` : nf.format(v);
  if (typeof v === 'boolean') return t(lang, v ? 'how.yes' : 'how.no');
  if (typeof v === 'string') return v;
  if (Array.isArray(v)) return v.length > 8 ? `${v.length} ${lang === 'uk' ? 'рядків' : 'rows'}` : v.map((x) => (Array.isArray(x) ? x.join(' → ') : typeof x === 'object' ? JSON.stringify(x) : String(x))).join(' · ');
  return Object.entries(v as object).map(([k, x]) => `${k}: ${typeof x === 'object' ? JSON.stringify(x).replace(/["{}]/g, '') : x}`).join(' · ');
};
---
<Base lang={lang} page="how" title={`${t(lang, 'how.title')} — ${t(lang, 'brand.name')}`}>
  <section class="pagehead">
    <h1>{t(lang, 'how.title')}</h1>
    <p>{t(lang, 'how.lede')}</p>
  </section>
  <div class="inputs">
    <div class="cols">
      <section class="card"><h2>{t(lang, 'how.covers')}</h2><ul class="list">{tList(lang, 'how.coversList').map((x) => <li>{x}</li>)}</ul></section>
      <section class="card"><h2>{t(lang, 'how.not')}</h2><ul class="list">{tList(lang, 'how.notList').map((x) => <li>{x}</li>)}</ul></section>
    </div>
    <section class="card">
      <h2>{t(lang, 'how.open')}</h2>
      <p class="note">{t(lang, 'how.openLede')}</p>
      <ul class="list">
        {open.map((k) => <li>{t(lang, `param.${k}`)}: {raw[k].source}</li>)}
      </ul>
    </section>
    <section class="card">
      <h2>{t(lang, 'how.sources')}</h2>
      <p class="note">{t(lang, 'how.sourcesNote')}</p>
      <div class="tablewrap">
        <table>
          <thead><tr><th>{t(lang, 'how.param')}</th><th>{t(lang, 'how.value')}</th><th>{t(lang, 'how.source')}</th><th>{t(lang, 'how.status')}</th><th>{t(lang, 'how.checked')}</th></tr></thead>
          <tbody>
            {keys.map((k) => (
              <tr id={`p-${k}`}>
                <td>{t(lang, `param.${k}`)}</td>
                <td style="max-width:320px">{paramText(lang, k, raw[k].value)}</td>
                <td style="min-width:280px">{raw[k].source}</td>
                <td><span class={`chip ${raw[k].status === 'V' ? '' : 'neutral'}`}>{t(lang, `status.${raw[k].status}`)}</span></td>
                <td style="white-space:nowrap">{date(lang, raw[k].checked)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <p><a href={`${base}/${lang}/`} style="display:inline-flex;align-items:center;gap:6px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>{t(lang, 'how.back')}</a></p>
  </div>
</Base>
